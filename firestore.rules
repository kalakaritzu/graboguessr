rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Player profiles - Gråbopoints leaderboard. Anyone signed in (even
    // anonymously) can read the leaderboard; a player can only edit their
    // own doc, and only ever move points upward (no cheating the total down
    // via a malformed client write, though a determined player could still
    // inflate their own score - acceptable trust level for a small
    // friend-group game per the project brief).
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.points is number
        && request.resource.data.points >= resource.data.points;
    }

    // Multiplayer rooms. Small trusted friend-group scope (per brief) -
    // any signed-in player can read/write room state and submit guesses,
    // rather than locking down to exact host/player identity checks.
    match /rooms/{roomCode} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;

      match /rounds/{roundIndex}/guesses/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}

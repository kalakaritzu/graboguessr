         regardless of system theme, for visual consistency across screens. -->
    <color name="bg">#10140F</color>
    <color name="surface">#1A211B</color>
    <color name="surface_variant">#232C24</color>
    <color name="on_surface">#F2F6EF</color>
    <color name="on_surface_muted">#93A38F</color>
    <color name="outline">#2B362C</color>

    <color name="accent">#33C287</color>
    <color name="accent_on">#062015</color>
    <color name="warning">#E3A94C</color>

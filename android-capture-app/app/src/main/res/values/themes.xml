<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Always-dark theme (not DayNight) - a camera app's chrome should stay
         legible over a live preview regardless of the system light/dark setting. -->
    <style name="Theme.GraboCapture" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent</item>
        <item name="colorOnPrimary">@color/accent_on</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent</item>
        <item name="colorOnSecondary">@color/accent_on</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_surface_muted</item>
    </style>

    <!-- Toolbar shared by every non-camera screen. -->
    <style name="Widget.Grabo.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/surface</item>
        <item name="titleTextColor">@color/on_surface</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Translucent pill button floating over the camera preview (Spots, Map, Hide UI...). -->
    <style name="Widget.Grabo.PillButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="backgroundTint">@color/scrim</item>
        <item name="cornerRadius">18dp</item>
        <item name="iconTint">@color/on_surface</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">6dp</item>
    </style>

    <!-- Same pill, but sized to be a perfect circle - icon-only controls. -->
    <style name="Widget.Grabo.PillButton.Icon">
        <item name="android:paddingHorizontal">0dp</item>
        <item name="android:paddingVertical">0dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- Primary filled action (Take Photo, Delete confirmation, etc). -->
    <style name="Widget.Grabo.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/accent_on</item>
        <item name="cornerRadius">28dp</item>
    </style>
</resources>
